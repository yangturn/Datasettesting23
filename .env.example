# OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Model every pipeline stage generates with. OpenRouter slug — see
# https://openrouter.ai/models. Change this to re-run the benchmark on a
# different model; never hardcode a model at a call site.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional higher-quality model used only to convert each BehaviorChain
# profile + chapter-summary history into this project's canonical biography.
# Defaults to OPENROUTER_MODEL when omitted. Converted profiles are cached.
BEHAVIORCHAIN_PROFILE_MODEL=deepseek/deepseek-v4-pro-0813

# Global cap for BehaviorChain OpenRouter requests. Override it for one run
# with `--concurrency N`.
BEHAVIORCHAIN_CONCURRENCY=24

# Ceiling on how many profiles a single Stage 0 run may generate. The population
# itself is uncapped — repeated additive runs can grow it past this. Defaults to
# 500 if unset or invalid.
MAX_PROFILES_PER_RUN=500

# How many profiles share a single model call in Stage 0. Larger batches pull
# profiles apart better (they see each other) and cost fewer requests, but the
# response gets longer and a failed call loses every profile in it. Defaults to
# 10 if unset or invalid.
PROFILES_PER_REQUEST=10

# Local dev only: route OpenRouter (and all other server-side fetch) calls
# through a local proxy — needed when a model 403s as region-blocked. Remove
# for production, where the proxy won't exist.
OPENROUTER_PROXY_URL=
